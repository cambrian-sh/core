# PLAT-04 / ADR-0066 — the build context is the monorepo root; keep it lean.
# Go build artifacts and local state
**/.git
**/.codegraph
**/.claude
**/.venv
**/venv
**/__pycache__
**/*.pyc
**/node_modules
cambrian-core/data
cambrian-core/tmp
cambrian-core/.claude
**/*.db
**/*.log

# Local, gitignored configs & secrets must never enter the image (compose mounts them)
cambrian-core/configs/config.json
cambrian-core/configs/config.local.json
cambrian-core/configs/embedder.json
cambrian-core/configs/embedder.local.json
cambrian-core/configs/providers.json
cambrian-core/configs/providers.local.json
cambrian-core/configs/tuning.local.json
cambrian-core/configs/mcp.json
# Backup / merge-leftover / atomic-write temp copies (same list as .gitignore;
# T-20261118-stale-config-backups-configs-config-json-bak): COPY cambrian-core/configs/
# ships the directory, so a local config.json.bak-<date> would carry an operator's
# real settings into the image even while git ignores it.
**/*.bak
**/*.bak-*
**/*.bak.*
**/*.bak_*
**/*.orig
**/*.rej
**/*.old
**/*.backup
**/*.swp
**/*~
**/.*.tmp-*
**/*.pre-compact
# The ADR-0101 D6 store encryption key: gitignored, but present on every dev machine
# that has booted a kernel, so a local `docker build` would bake it into a layer.
**/secret.key
**/.env

# The kernel-managed sandbox Python env of a dev checkout (ADR-0157 D7, ~1-4 GB):
# the image builds its own generation.
cambrian-core/runtime

# Other repos in the monorepo not needed by the kernel image. Since ENG-2077 that
# includes the agent SDK: the env is built from the release base lock (the published
# SDK), not from the sibling sdk/ checkout.
ui
cli
sdk
cambrian-premium
cambrian-benchmarks
cambrian-worldsim
cambrian-knowledge
www
