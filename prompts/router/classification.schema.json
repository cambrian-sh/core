{
  "title": "RouteClassification",
  "description": "The decision for one user input. Mirrors classifyResponse in internal/router/default_router.go.",
  "type": "object",
  "additionalProperties": false,
  "required": ["decision", "confidence", "alternatives", "reason"],
  "properties": {
    "decision": { "type": "string", "enum": ["chat", "plan", "watch"] },
    "confidence": { "type": "number", "description": "Probability from 0 to 1 that decision is what the user meant." },
    "alternatives": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["decision", "confidence"],
        "properties": {
          "decision": { "type": "string", "enum": ["chat", "plan", "watch"] },
          "confidence": { "type": "number", "description": "Probability from 0 to 1." }
        }
      }
    },
    "reason": { "type": "string", "description": "One sentence." }
  }
}
