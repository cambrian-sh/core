{
  "_comment": "User-facing infrastructure config. Copy to config.json (gitignored) and fill in. The embedder model lives in configs/embedder.json (gitignored; copy from embedder.json.example). The LLM provider list lives in configs/providers.json (gitignored; copy from providers.json.example). Hyperparameters live in configs/tuning.local.json (gitignored; or commit a curated set in configs/tuning.json). External MCP server definitions live in configs/mcp.json (gitignored; copy from mcp.json.example). Secrets come from .env via api_key_env / CAMBRIAN_* env vars, never inline. Telemetry is OFF by default (see telemetry block).",
  "metabolism": {
    "python_executable": "python",
    "agents_dir": "./agents"
  },
  "storage": {
    "data_dir": "data",
    "db_name": "agents.db"
  },
  "database": {
    "host": "127.0.0.1",
    "port": "5432",
    "user": "cambrian_admin",
    "password": "cambrian_password",
    "dbname": "cambrian_db"
  },
  "server": {
    "port": "50051"
  },
  "telemetry": {
    "otlp_endpoint": "",
    "trace_sampling_rate": 1.0,
    "metrics_export_interval_seconds": 10,
    "enable_stdout_exporter": false,
    "prometheus_port": 0
  },
  "execution": {
    "chat_pool_size": 2,
    "chat_pool_agent_id": "chat_agent",
    "chat_pool_queue_size": 8,
    "agentic_retrieval_enabled": false,
    "agentic_decompose_enabled": true,
    "reranker_enabled": false,
    "ingestion": {
      "evidence_capture_enabled": true
    },
    "llm": {
      "trace_pipeline_payloads": true
    },
    "pipelines": {
      "drainer_enabled": true
    },
    "retrieval": {
      "reranker_model": "BAAI/bge-reranker-v2-m3"
    }
  }
}