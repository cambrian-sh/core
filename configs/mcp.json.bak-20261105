{
  "_comment": "MCP server definitions (gitignored). Loaded by LoadConfig after config.json + tuning.local.json. Wins over a `mcp` block in config.json (back-compat for legacy config.json files). To add a server, copy this file's shape. Auth secrets come from env vars (auth.token_env); never inline them. WARNING: an empty `{\"mcp\": {}}` here will silently wipe any `mcp` block in config.json because Koanf merges per-key \u00e2\u20ac\u201d don't create this file if you don't use MCP.",
  "_comment_policy": "ADR-0139 D8: a tool with no `tools` entry and no `default_tool_policy` is DANGEROUS (approval required) with effects read+write+egress. sequential-thinking, pdf-reader and the tau2 mocks are declared read-only here (the tau2 tools mutate only the in-process mock DB). super-shell, filesystem, fast-filesystem, fetch and firecrawl are deliberately left fail-closed. stdio servers inherit only the OS essentials plus their `env` list.",
  "mcp": {
    "default_session_budget": 0,
    "call_timeout_ms": 60000,
    "servers": [
      {
        "id": "firecrawl",
        "transport": "http",
        "endpoint": "http://localhost:3006/mcp",
        "auth": {
          "type": "none"
        }
      },
      {
        "id": "fast-filesystem",
        "transport": "stdio",
        "endpoint": "npx",
        "args": [
          "-y",
          "fast-filesystem-mcp"
        ],
        "auth": {
          "type": "none"
        }
      },
      {
        "id": "sequential-thinking",
        "transport": "stdio",
        "endpoint": "npx",
        "args": [
          "-y",
          "@modelcontextprotocol/server-sequential-thinking"
        ],
        "auth": {
          "type": "none"
        },
        "default_tool_policy": {
          "effects": [
            "read"
          ]
        }
      },
      {
        "id": "fetch",
        "transport": "stdio",
        "endpoint": "uvx",
        "args": [
          "mcp-server-fetch"
        ],
        "auth": {
          "type": "none"
        }
      },
      {
        "id": "filesystem",
        "transport": "stdio",
        "endpoint": "npx",
        "args": [
          "-y",
          "@modelcontextprotocol/server-filesystem",
          "."
        ],
        "auth": {
          "type": "none"
        }
      },
      {
        "id": "super-shell",
        "transport": "stdio",
        "endpoint": "npx",
        "args": [
          "-y",
          "@cfdude/super-shell-mcp"
        ],
        "auth": {
          "type": "none"
        }
      },
      {
        "id": "pdf-reader",
        "transport": "stdio",
        "endpoint": "npx",
        "args": [
          "-y",
          "@sylphx/pdf-reader-mcp"
        ],
        "auth": {
          "type": "none"
        },
        "default_tool_policy": {
          "effects": [
            "read"
          ]
        }
      },
      {
        "id": "tau2-mock",
        "transport": "stdio",
        "endpoint": "python",
        "args": [
          "C:/Users/afsin/Dev/cambrian/cambrian-core/tools/tau2_mcp/server.py"
        ],
        "auth": {
          "type": "none"
        },
        "default_tool_policy": {
          "effects": [
            "read"
          ]
        },
        "env": [
          "TAU2_MOCK_DB_OUT"
        ]
      },
      {
        "id": "tau2-retail",
        "transport": "stdio",
        "endpoint": "python",
        "args": [
          "C:/Users/afsin/Dev/cambrian/cambrian-core/tools/tau2_mcp/airline_proxy.py"
        ],
        "auth": {
          "type": "none"
        },
        "default_tool_policy": {
          "effects": [
            "read"
          ]
        },
        "env": [
          "TAU2_HUB_URL",
          "AIRLINE_HUB_URL",
          "TAU2_MCP_NAME"
        ]
      },
      {
        "id": "tau2-airline",
        "transport": "stdio",
        "endpoint": "python",
        "args": [
          "C:/Users/afsin/Dev/cambrian/cambrian-core/tools/tau2_mcp/airline_proxy.py"
        ],
        "auth": {
          "type": "none"
        },
        "classification_tags": [
          "airline"
        ],
        "default_tool_policy": {
          "effects": [
            "read"
          ]
        },
        "env": [
          "TAU2_HUB_URL",
          "AIRLINE_HUB_URL",
          "TAU2_MCP_NAME"
        ]
      }
    ]
  }
}