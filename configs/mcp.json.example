      {
        "id": "markitdown",
        "catalog_id": "markitdown",
        "_note": "Microsoft MarkItDown MCP (microsoft/markitdown, MIT; package is pre-release 0.0.1a8): converts docx/xlsx/pptx/pdf/html/csv/images to Markdown. The uri may be http(s), file: or data:, so reads carry egress. Upstream says local, trusted use only. Needs --prerelease=allow: a transitive dependency (azure-ai-contentunderstanding) is only published as a pre-release. Handshake verified 2026-11-05 (tool: convert_to_markdown).",
        "transport": "stdio",
        "endpoint": "uvx",
        "args": [
          "--prerelease=allow",
