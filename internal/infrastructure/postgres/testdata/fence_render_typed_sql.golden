- link exists (l)
  sql:  " AND EXISTS (SELECT 1 FROM evidence e\n\t\tWHERE e.id = l.evidence_id AND NOT EXISTS (SELECT 1 FROM unnest(e.classification) AS owner_tag(t) WHERE starts_with(owner_tag.t, 'owner:') AND owner_tag.t <> ALL($3::text[])) AND (l.classification IS NULL OR cardinality(l.classification) = 0 OR (NOT EXISTS (SELECT 1 FROM unnest((e.classification || l.classification)) AS owner_tag(t) WHERE starts_with(owner_tag.t, 'owner:') AND owner_tag.t <> ALL($4::text[]))))) AND NOT EXISTS (SELECT 1 FROM unnest(l.supporting_evidence) AS link_support(id)\n\t\tWHERE NOT EXISTS (SELECT 1 FROM evidence e\n\t\t\tWHERE e.id = link_support.id AND NOT EXISTS (SELECT 1 FROM unnest(e.classification) AS owner_tag(t) WHERE starts_with(owner_tag.t, 'owner:') AND owner_tag.t <> ALL($5::text[]))))"
