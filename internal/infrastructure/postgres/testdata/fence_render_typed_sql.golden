## bypass (system)
- typed row exists (o.evidence_id, o.classification)
  sql:  " AND EXISTS (SELECT 1 FROM evidence e\n\t\tWHERE e.id = o.evidence_id AND NOT EXISTS (SELECT 1 FROM unnest(e.classification) AS owner_tag(t) WHERE starts_with(owner_tag.t, 'owner:') AND owner_tag.t <> ALL($3::text[])) AND (o.classification IS NULL OR cardinality(o.classification) = 0 OR (NOT EXISTS (SELECT 1 FROM unnest((e.classification || o.classification)) AS owner_tag(t) WHERE starts_with(owner_tag.t, 'owner:') AND owner_tag.t <> ALL($4::text[])))))"
  args: []interface {}{[]string{}, []string{}}
- object property with row tags
  sql:  "(o.p__tags IS NOT NULL AND NOT EXISTS (SELECT 1 FROM unnest(o.p__tags) AS owner_tag(t) WHERE starts_with(owner_tag.t, 'owner:') AND owner_tag.t <> ALL($3::text[])) AND (o.p__rowtags IS NULL OR cardinality(o.p__rowtags) = 0 OR (NOT EXISTS (SELECT 1 FROM unnest((o.p__tags || o.p__rowtags)) AS owner_tag(t) WHERE starts_with(owner_tag.t, 'owner:') AND owner_tag.t <> ALL($4::text[])))))"
  args: []interface {}{[]string{}, []string{}}
- object extra with row tags
  sql:  "((CASE WHEN jsonb_typeof(x.value->'tags') = 'array' THEN ARRAY(SELECT jsonb_array_elements_text(x.value->'tags')) END) IS NOT NULL AND NOT EXISTS (SELECT 1 FROM unnest((CASE WHEN jsonb_typeof(x.value->'tags') = 'array' THEN ARRAY(SELECT jsonb_array_elements_text(x.value->'tags')) END)) AS owner_tag(t) WHERE starts_with(owner_tag.t, 'owner:') AND owner_tag.t <> ALL($3::text[])) AND (ARRAY(SELECT jsonb_array_elements_text(CASE WHEN jsonb_typeof(x.value->'row_tags') = 'array' THEN x.value->'row_tags' ELSE '[]'::jsonb END)) IS NULL OR cardinality(ARRAY(SELECT jsonb_array_elements_text(CASE WHEN jsonb_typeof(x.value->'row_tags') = 'array' THEN x.value->'row_tags' ELSE '[]'::jsonb END))) = 0 OR (NOT EXISTS (SELECT 1 FROM unnest(((CASE WHEN jsonb_typeof(x.value->'tags') = 'array' THEN ARRAY(SELECT jsonb_array_elements_text(x.value->'tags')) END) || ARRAY(SELECT jsonb_array_elements_text(CASE WHEN jsonb_typeof(x.value->'row_tags') = 'array' THEN x.value->'row_tags' ELSE '[]'::jsonb END)))) AS owner_tag(t) WHERE starts_with(owner_tag.t, 'owner:') AND owner_tag.t <> ALL($4::text[])))))"
  args: []interface {}{[]string{}, []string{}}
- fence class triple
  sql:  "(c.tags IS NOT NULL AND NOT EXISTS (SELECT 1 FROM unnest(c.tags) AS owner_tag(t) WHERE starts_with(owner_tag.t, 'owner:') AND owner_tag.t <> ALL($3::text[])) AND (c.row_tags IS NULL OR cardinality(c.row_tags) = 0 OR (NOT EXISTS (SELECT 1 FROM unnest((c.tags || c.row_tags)) AS owner_tag(t) WHERE starts_with(owner_tag.t, 'owner:') AND owner_tag.t <> ALL($4::text[])))))"
