## bypass (system)
- evidence exists (query plane: observations/events/outbox)
  sql:  " AND EXISTS (SELECT 1 FROM evidence e\n\t\tWHERE e.id = r.evidence_id AND NOT EXISTS (SELECT 1 FROM unnest(e.classification) AS owner_tag(t) WHERE starts_with(owner_tag.t, 'owner:') AND owner_tag.t <> ALL($3::text[])))"
  args: []interface {}{[]string{}}
- evidence row (alias e)
  sql:  " AND NOT EXISTS (SELECT 1 FROM unnest(e.classification) AS owner_tag(t) WHERE starts_with(owner_tag.t, 'owner:') AND owner_tag.t <> ALL($3::text[]))"
  args: []interface {}{[]string{}}
- item (alias ki, TEXT[] classification)
  sql:  " AND NOT EXISTS (SELECT 1 FROM unnest(ki.classification) AS owner_tag(t) WHERE starts_with(owner_tag.t, 'owner:') AND owner_tag.t <> ALL($3::text[]))"
  args: []interface {}{[]string{}}
- text array (catalog: any TEXT[] column)
  sql:  " AND NOT EXISTS (SELECT 1 FROM unnest(x.classification) AS owner_tag(t) WHERE starts_with(owner_tag.t, 'owner:') AND owner_tag.t <> ALL($3::text[]))"
  args: []interface {}{[]string{}}
- jsonb metadata (unqualified)
  sql:  "SELECT id FROM fence_docs WHERE NOT jsonb_path_exists(metadata, $1::jsonpath, $2::jsonb)"
  args: []interface {}{"lax $.tags[*] ? (@ starts with \"owner:\")", "{}"}
- jsonb metadata (alias c)
  sql:  "SELECT id FROM fence_docs c WHERE NOT jsonb_path_exists(c.metadata, $1::jsonpath, $2::jsonb)"
  args: []interface {}{"lax $.tags[*] ? (@ starts with \"owner:\")", "{}"}

