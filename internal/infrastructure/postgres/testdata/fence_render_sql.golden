## own-rows
- evidence exists (query plane: observations/events/outbox)
  sql:  " AND EXISTS (SELECT 1 FROM evidence e\n\t\tWHERE e.id = r.evidence_id AND ((NOT EXISTS (SELECT 1 FROM unnest(e.classification) AS owner_tag(t) WHERE starts_with(owner_tag.t, 'owner:') AND owner_tag.t <> ALL($3::text[])) AND NOT (e.classification && $4) AND e.classification && $5) OR (e.classification @> ARRAY[$6::text] AND NOT EXISTS (SELECT 1 FROM unnest(e.classification) AS owner_tag(t) WHERE starts_with(owner_tag.t, 'owner:') AND owner_tag.t <> ALL($7::text[])) AND NOT (e.classification && $8))))"
