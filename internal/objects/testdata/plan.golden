SELECT o.entity_id, CASE WHEN (o."channel__tags" IS NOT NULL AND NOT EXISTS (SELECT 1 FROM unnest(o."channel__tags") AS owner_tag(t) WHERE starts_with(owner_tag.t, 'owner:') AND owner_tag.t <> ALL($1::text[]))) THEN o."channel__text" END, CASE WHEN (o."customer__tags" IS NOT NULL AND NOT EXISTS (SELECT 1 FROM unnest(o."customer__tags") AS owner_tag(t) WHERE starts_with(owner_tag.t, 'owner:') AND owner_tag.t <> ALL($2::text[]))) THEN o."customer__entity" END, CASE WHEN (o."due_date__tags" IS NOT NULL AND NOT EXISTS (SELECT 1 FROM unnest(o."due_date__tags") AS owner_tag(t) WHERE starts_with(owner_tag.t, 'owner:') AND owner_tag.t <> ALL($3::text[]))) THEN o."due_date__date" END, CASE WHEN (o."status__tags" IS NOT NULL AND NOT EXISTS (SELECT 1 FROM unnest(o."status__tags") AS owner_tag(t) WHERE starts_with(owner_tag.t, 'owner:') AND owner_tag.t <> ALL($4::text[]))) THEN o."status__text" END, CASE WHEN (o."total__tags" IS NOT NULL AND NOT EXISTS (SELECT 1 FROM unnest(o."total__tags") AS owner_tag(t) WHERE starts_with(owner_tag.t, 'owner:') AND owner_tag.t <> ALL($5::text[]))) THEN o."total__number" END FROM "objects_order" o WHERE o.namespace_id = $6 AND (EXISTS (SELECT 1 FROM entities en WHERE en.id = o.entity_id AND en.namespace_id = o.namespace_id AND EXISTS (SELECT 1 FROM evidence e
		WHERE e.id = en.first_seen_evidence AND NOT EXISTS (SELECT 1 FROM unnest(e.classification) AS owner_tag(t) WHERE starts_with(owner_tag.t, 'owner:') AND owner_tag.t <> ALL($7::text[])))) OR (o."channel__tags" IS NOT NULL AND NOT EXISTS (SELECT 1 FROM unnest(o."channel__tags") AS owner_tag(t) WHERE starts_with(owner_tag.t, 'owner:') AND owner_tag.t <> ALL($8::text[]))) OR (o."customer__tags" IS NOT NULL AND NOT EXISTS (SELECT 1 FROM unnest(o."customer__tags") AS owner_tag(t) WHERE starts_with(owner_tag.t, 'owner:') AND owner_tag.t <> ALL($9::text[]))) OR (o."due_date__tags" IS NOT NULL AND NOT EXISTS (SELECT 1 FROM unnest(o."due_date__tags") AS owner_tag(t) WHERE starts_with(owner_tag.t, 'owner:') AND owner_tag.t <> ALL($10::text[]))) OR (o."status__tags" IS NOT NULL AND NOT EXISTS (SELECT 1 FROM unnest(o."status__tags") AS owner_tag(t) WHERE starts_with(owner_tag.t, 'owner:') AND owner_tag.t <> ALL($11::text[]))) OR (o."total__tags" IS NOT NULL AND NOT EXISTS (SELECT 1 FROM unnest(o."total__tags") AS owner_tag(t) WHERE starts_with(owner_tag.t, 'owner:') AND owner_tag.t <> ALL($12::text[])))) ORDER BY o.entity_id ASC LIMIT 51
