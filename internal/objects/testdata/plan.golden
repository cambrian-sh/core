		WHERE e.id = en.first_seen_evidence AND NOT EXISTS (SELECT 1 FROM unnest(e.classification) AS owner_tag(t) WHERE starts_with(owner_tag.t, 'owner:') AND owner_tag.t <> ALL($12::text[])) AND NOT (e.classification && $13) AND e.classification && $14 AND (NOT (e.classification && $15) OR e.parties && $16))) OR (o."channel__tags" IS NOT NULL AND NOT EXISTS (SELECT 1 FROM unnest(o."channel__tags") AS owner_tag(t) WHERE starts_with(owner_tag.t, 'owner:') AND owner_tag.t <> ALL($17::text[])) AND NOT (o."channel__tags" && $18) AND o."channel__tags" && $19 AND (NOT (o."channel__tags" && $20) OR o."channel__parties" && $21)) OR (o."customer__tags" IS NOT NULL AND NOT EXISTS (SELECT 1 FROM unnest(o."customer__tags") AS owner_tag(t) WHERE starts_with(owner_tag.t, 'owner:') AND owner_tag.t <> ALL($22::text[])) AND NOT (o."customer__tags" && $23) AND o."customer__tags" && $24 AND (NOT (o."customer__tags" && $25) OR o."customer__parties" && $26)) OR (o."due_date__tags" IS NOT NULL AND NOT EXISTS (SELECT 1 FROM unnest(o."due_date__tags") AS owner_tag(t) WHERE starts_with(owner_tag.t, 'owner:') AND owner_tag.t <> ALL($27::text[])) AND NOT (o."due_date__tags" && $28) AND o."due_date__tags" && $29 AND (NOT (o."due_date__tags" && $30) OR o."due_date__parties" && $31)) OR (o."status__tags" IS NOT NULL AND NOT EXISTS (SELECT 1 FROM unnest(o."status__tags") AS owner_tag(t) WHERE starts_with(owner_tag.t, 'owner:') AND owner_tag.t <> ALL($32::text[])) AND NOT (o."status__tags" && $33) AND o."status__tags" && $34 AND (NOT (o."status__tags" && $35) OR o."status__parties" && $36)) OR (o."total__tags" IS NOT NULL AND NOT EXISTS (SELECT 1 FROM unnest(o."total__tags") AS owner_tag(t) WHERE starts_with(owner_tag.t, 'owner:') AND owner_tag.t <> ALL($37::text[])) AND NOT (o."total__tags" && $38) AND o."total__tags" && $39 AND (NOT (o."total__tags" && $40) OR o."total__parties" && $41))) GROUP BY 1 ORDER BY 1 NULLS LAST LIMIT 1001
